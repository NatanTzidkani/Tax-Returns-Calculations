DATABASE_URL=postgresql://tax:tax@localhost:5432/taxreturns
ANTHROPIC_API_KEY=
STORAGE_PATH=./data/documents

# Google Sign-In (see docs/superpowers/plans/2026-07-06-google-sign-in.md).
# GOOGLE_CLIENT_ID: Google Cloud Console → APIs & Services → Credentials →
#   "Create OAuth client ID" → Web application → add authorized JavaScript
#   origin http://localhost:5173 (and your real origin later). No client
#   secret is needed — this app only verifies ID tokens, it never exchanges
#   an auth code. The same value also goes in packages/web/.env as
#   VITE_GOOGLE_CLIENT_ID (see packages/web/.env.example).
GOOGLE_CLIENT_ID=
# OWNER_GOOGLE_EMAIL: the only Google account allowed to sign in.
OWNER_GOOGLE_EMAIL=
# SESSION_SECRET: 32+ random bytes for signing session cookies. Generate
# with `openssl rand -hex 32`. Required whenever NODE_ENV != test — there
# is no production fallback; an unset value fails loudly at startup.
SESSION_SECRET=
# COOKIE_SECURE: set to true to mark the session cookie Secure (HTTPS-only).
# Leave unset/false while the site is browsed over plain http:// — a Secure
# cookie is silently dropped by the browser on http, so sign-in "works" but
# never sticks. Behind an HTTPS-terminating reverse proxy, true is correct
# even though the app itself speaks plain HTTP (the browser enforces the
# flag against the page origin, not this server's socket). Never inferred
# from NODE_ENV — nothing in the deploy path sets it.
# COOKIE_SECURE=true

# NOTE: packages/api reads its own packages/api/.env (git-ignored), not this
# root file directly — copy the relevant lines above into it. This root
# .env.example documents the full set of variables the app needs across
# packages; packages/web/.env.example covers the browser-exposed subset.
